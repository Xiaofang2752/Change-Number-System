# Application Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration
DB_PATH=/app/data/app.db

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-secret-key-change-in-production

# Admin Password
ADMIN_PASSWORD=Aa123456

# Docker Image Configuration
# 镜像仓库地址和名称（阿里云镜像仓库）
DOCKER_REGISTRY=crpi-yl4pb9sg5y2myg6f.cn-hangzhou.personal.cr.aliyuncs.com
DOCKER_IMAGE_NAME=9992099/change_number_system

# Frontend Dify chatbot embed
# Leave base URL empty to use http://192.168.122.193:8090 on HTTP pages
# and Traefik HTTPS on HTTPS pages.
